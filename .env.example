# 로컬 개발용 (.env 로 복사해서 사용). 배포는 GitHub 저장소 Settings > Variables 에 같은 이름으로 넣으면 됨
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 > SDK 설정
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Firebase AI Logic (Gemini Developer API) — 콘솔에서 AI Logic 활성화만 하면 API 키 따로 필요 없음
NUXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
# App Check (reCAPTCHA Enterprise 사이트 키)
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
