rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 오늘의 신탁: 누구나 읽기 / 그날 처음 한 번만 생성 가능 / 수정·삭제 불가
    match /oracles/{day} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.day == day
        && request.resource.data.keys().hasOnly(['day', 'name', 'mutators', 'bossTitle', 'line', 'source'])
        && request.resource.data.mutators is list
        && request.resource.data.mutators.size() >= 2
        && request.resource.data.mutators.size() <= 3
        && request.resource.data.mutators.hasOnly(['giant', 'swarm', 'bloodmoon', 'greed', 'split', 'storm', 'glass', 'haste', 'magnetic', 'fog', 'elite', 'vampire', 'echo', 'treasure', 'tiny', 'rush'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.bossTitle is string && request.resource.data.bossTitle.size() <= 8
        && request.resource.data.line is string && request.resource.data.line.size() <= 40;
      allow update, delete: if false;
    }

    // 영구 성장 데이터: 본인만 읽고 쓰기
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 일일 랭킹: 누구나 읽기, 본인 기록만 쓰기 (값 범위 검사)
    match /daily/{day}/scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'kills', 'time', 'level', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score < 50000000
        && request.resource.data.time is int && request.resource.data.time < 86400;
    }
    match /daily/{day}/cards/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'kills', 'time', 'level', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score < 50000000
        && request.resource.data.time is int && request.resource.data.time < 86400;
    }
  }
}
